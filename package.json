{
  "name": "qdii-tracker",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.8"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint frontend/src test/frontend test/e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:t0": "npm run typecheck && npm run lint && npm test",
    "test:t1": "playwright test --project=chromium-desktop --grep-invert \"visual baselines\"",
    "test:t2": "playwright test --project=chromium-desktop --grep-invert \"visual baselines\"",
    "test:t3": "playwright test --project=chromium-desktop --project=chromium-mobile --grep-invert \"visual baselines\"",
    "test:e2e": "npm run test:t3",
    "test:e2e:funds": "playwright test test/e2e/funds.spec.ts --project=chromium-desktop",
    "test:e2e:research": "playwright test test/e2e/research.spec.ts --project=chromium-desktop",
    "test:visual": "playwright test test/e2e/visual.spec.ts --project=chromium-desktop",
    "test:visual:update": "playwright test test/e2e/visual.spec.ts --project=chromium-desktop --update-snapshots",
    "test:a11y": "playwright test test/e2e/accessibility.spec.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@tanstack/vue-table": "^9.3.1",
    "dexie": "^4.4.7",
    "echarts": "^6.1.0",
    "html-to-image": "^1.11.13",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lucide/vue": "^1.73.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "fake-indexeddb": "^6.2.8",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
